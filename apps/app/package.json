{
  "name": "@cocoasurface/app",
  "version": "0.1.0",
  "private": true,
  "description": "CocoaSurface desktop application",
  "author": "CocoaSuite",
  "license": "UNLICENSED",
  "homepage": "https://github.com/CocoaSuite/CocoaSurface",
  "productName": "CocoaSurface",
  "desktopName": "cocoasurface.desktop",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@cocoasurface/materials": "^0.1.0",
    "@cocoasurface/project": "^0.1.0",
    "@cocoasurface/ui": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "mikktspace": "^1.1.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.cocoasuite.cocoasurface",
    "productName": "CocoaSurface",
    "copyright": "Copyright © CocoaSuite",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "cocoasurf",
        "name": "CocoaSurface Project",
        "description": "CocoaSurface project",
        "mimeType": "application/x-cocoasurface",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CocoaSurface",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "maintainer": "CocoaSuite",
      "executableName": "cocoasurface",
      "synopsis": "3D texture painting and material authoring",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "cocoasurface"
    },
    "publish": null
  }
}
